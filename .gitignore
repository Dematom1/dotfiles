# Generated skill content is not committed. See .agents/SKILLS.md for sources,
# authentication requirements, and regeneration instructions.
/.agents/skills/*
!/.agents/skills/.gitkeep
/opencode/skills/*
!/opencode/skills/.gitkeep

# Tool-local state, caches, and tool-installed plugins - all regenerated
# (tokensave index DB, Claude project state, opencode plugins from AXI/memtrace,
# via `just setup-firstmate` / `just update-skills`).
/.tokensave/
/.memdb/
/.memtrace/
/.claude/
/herdr/release-notes.json
/profile.json.gz
/opencode/plugin/
/opencode/plugins/

# Python bytecode caches
__pycache__/
*.py[cod]
