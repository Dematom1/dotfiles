# Generated skills are ignored; local skills are committed. See .agents/SKILLS.md.
/.agents/skills/*
!/.agents/skills/.gitkeep
!/.agents/skills/trim/
!/.agents/skills/trim/SKILL.md
/opencode/skills/*
!/opencode/skills/.gitkeep

# Tool-local state, caches, and tool-installed plugins - all regenerated
# (tokensave index DB, Claude project state, and opencode plugins via
# `just setup-firstmate` / `just update-skills`). Project skills in
# .claude/skills/ are committed.
/.tokensave/
/.claude/*
!/.claude/skills/
/herdr/release-notes.json
/profile.json.gz
/opencode/plugin/
/opencode/plugins/

# nix build output links.
/result
/result-*

__pycache__/
*.pyc
