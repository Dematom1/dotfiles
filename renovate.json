{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":separateMajorReleases"
  ],
  "labels": ["dependencies", "agent-task"],
  "schedule": ["before 9am on monday"],
  "timezone": "Europe/London",
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Nix-packaged CLIs (packages/npm/<name>): checked daily and auto-merged by GitHub once the required darwin-build check passes",
      "matchFileNames": ["packages/npm/**"],
      "schedule": ["before 6am"],
      "minimumReleaseAge": "1 day",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Group TanStack packages",
      "groupName": "TanStack",
      "matchPackageNames": ["/^@tanstack//"]
    },
    {
      "description": "Group Drizzle packages",
      "groupName": "Drizzle",
      "matchPackageNames": ["/^drizzle/"]
    },
    {
      "description": "Group React packages",
      "groupName": "React",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"]
    },
    {
      "description": "Group Tailwind packages",
      "groupName": "Tailwind CSS",
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/vite",
        "tailwind-merge",
        "prettier-plugin-tailwindcss"
      ]
    },
    {
      "description": "Group Vite packages",
      "groupName": "Vite",
      "matchPackageNames": ["/^vite/", "/^@vitejs//"]
    },
    {
      "description": "Group ESLint packages",
      "groupName": "ESLint",
      "matchPackageNames": ["/eslint/"]
    },
    {
      "description": "Group TypeScript packages",
      "groupName": "TypeScript",
      "matchPackageNames": ["typescript", "typescript-eslint"]
    },
    {
      "description": "Group type definitions",
      "groupName": "Type definitions",
      "matchPackageNames": ["/^@types//", "!@types/react", "!@types/react-dom"]
    },
    {
      "description": "Group Pydantic packages",
      "groupName": "Pydantic",
      "matchPackageNames": ["/^pydantic/"]
    },
    {
      "description": "Group psycopg packages",
      "groupName": "psycopg",
      "matchPackageNames": ["/^psycopg/"]
    },
    {
      "description": "Group SQLAlchemy and Alembic",
      "groupName": "SQLAlchemy",
      "matchPackageNames": ["sqlalchemy", "alembic"]
    },
    {
      "description": "Group FastAPI and Uvicorn",
      "groupName": "FastAPI",
      "matchPackageNames": ["fastapi", "uvicorn"]
    },
    {
      "description": "Group Python testing tools",
      "groupName": "Python testing",
      "matchPackageNames": ["pytest", "pytest-asyncio", "httpx"]
    },
    {
      "description": "Group Python linting/typing tools",
      "groupName": "Python linting",
      "matchPackageNames": ["ruff", "ty"]
    },
    {
      "description": "Group Docker base images",
      "groupName": "Docker images",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^python$/", "/^postgres$/", "/^node$/"]
    }
  ]
}
